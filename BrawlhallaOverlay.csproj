<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BrawlhallaOverlay</AssemblyName>
    <RootNamespace>BrawlhallaOverlay</RootNamespace>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms auto-adds these as global usings, which collide with WPF's
         own System.Windows.* implicit usings (Color, Point, Application, etc).
         Code that needs WinForms types (NotifyIcon, tray menu) uses fully-qualified
         names instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Portraits de légend (mode Tutoriel, coin haut-gauche du panneau de combo) —
         renders officiels récupérés sur brawlhalla.com/legends/, voir Config/LegendComboPresets.cs
         et Windows/MainWindow.xaml.cs (LegendPortraitFileName) pour le détail du sourcing. -->
    <Resource Include="Assets\Legends\*.png" />
    <!-- Icônes d'arme (panneau de combo, mode Tutoriel, à côté du portrait de personnage) —
         icônes officielles récupérées sur brawlhalla.com/legends/ (même hôte CDN cms.brawlhalla.com
         que les portraits ci-dessus), une par arme du jeu. Voir Config/WeaponIconAssets.cs pour le
         mapping nom d'arme -> fichier. -->
    <Resource Include="Assets\Weapons\*.png" />
    <Resource Include="Assets\Weapons\*.jpg" />
    <!-- Logo de l'app (icône de tray + icône des fenêtres bordées) — logo officiel Brawlhalla
         fourni directement par l'utilisateur (logo\logo_app.png), pas un logo custom dessiné pour
         cet outil. Utilisé sciemment malgré l'affiliation visuelle que ça implique (confirmé par
         l'utilisateur) ; remplace l'ancienne icône "B" dessinée au runtime dans MainWindow.CreateTrayIcon. -->
    <Resource Include="Assets\AppLogo.png" />
  </ItemGroup>

</Project>
